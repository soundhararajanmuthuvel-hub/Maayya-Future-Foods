# Maayya Future Foods — Smart Business Manager
# Environment Variables Configuration
# Developed and maintained by MSR Solutions

# Application Port (Render / Hosting environment default)
PORT=3000

# Base URL where this web application is hosted
APP_URL="https://maayya-future-foods.vercel.app"

# Web Push Notifications (Optional VAPID credentials)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@localhost"

# Database Connection (Render PostgreSQL - Server side only, never expose to frontend)
# DATABASE_URL="postgresql://username:password@render-host/database"
